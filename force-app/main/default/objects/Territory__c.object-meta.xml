<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Defines sales territories and their assignments</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <label>Territory</label>
    <pluralLabel>Territories</pluralLabel>
    <nameField>
        <label>Territory Name</label>
        <type>Text</type>
        <unique>true</unique>
    </nameField>
    <searchLayouts>
        <customTabListAdditionalFields>NAME</customTabListAdditionalFields>
    </searchLayouts>
    <validationRules>
        <fullName>Require_Territory_Name</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Name)</errorConditionFormula>
        <errorMessage>Territory Name is required.</errorMessage>
    </validationRules>
</CustomObject>
